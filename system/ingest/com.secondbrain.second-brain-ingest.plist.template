<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.secondbrain.second-brain-ingest</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__BRAIN_DIR__/system/ingest/run-ingest.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__BRAIN_DIR__</string>

    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/second-brain-ingest.log</string>

    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/second-brain-ingest.log</string>

    <!-- Nightly ingest: 2:30am local, same slot as the retired cron line.
         Moved cron -> launchd Jul 10 2026 because cron runs OUTSIDE the
         user's GUI/keychain session, so git's osxkeychain credential helper
         returned nothing and every `git push origin main` died with
         "could not read Username ... Device not configured" (18 commits
         piled up unpushed). launchd gui/ jobs run inside the Aqua session
         where the login keychain is reachable — same reason the bot,
         morning, and evening jobs already live here. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>2</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <!-- PATH must cover: node + yt-dlp (/opt/homebrew/bin), git helpers -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>__HOME__/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>__HOME__</string>
    </dict>
</dict>
</plist>
