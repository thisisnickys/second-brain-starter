<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.secondbrain.second-brain-evening</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/node</string>
        <string>__BRAIN_DIR__/system/telegram/evening.js</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__BRAIN_DIR__</string>

    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/second-brain-evening.log</string>

    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/second-brain-evening.log</string>

    <!-- Evening report: Mon-Sat at 11:59pm local (night owl - moved from
         10pm on Jul 13 2026; must stay before midnight so "today" resolves to
         the day being reported, and before the 2:30am ingest). SUNDAY IS
         EXCLUDED - the weekly report (com.secondbrain.second-brain-weekly,
         Sun 10pm) replaces it and absorbs its housekeeping. One shot per
         fire - the script sends and exits; no KeepAlive. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Weekday</key>
            <integer>1</integer>
            <key>Hour</key>
            <integer>23</integer>
            <key>Minute</key>
            <integer>59</integer>
        </dict>
        <dict>
            <key>Weekday</key>
            <integer>2</integer>
            <key>Hour</key>
            <integer>23</integer>
            <key>Minute</key>
            <integer>59</integer>
        </dict>
        <dict>
            <key>Weekday</key>
            <integer>3</integer>
            <key>Hour</key>
            <integer>23</integer>
            <key>Minute</key>
            <integer>59</integer>
        </dict>
        <dict>
            <key>Weekday</key>
            <integer>4</integer>
            <key>Hour</key>
            <integer>23</integer>
            <key>Minute</key>
            <integer>59</integer>
        </dict>
        <dict>
            <key>Weekday</key>
            <integer>5</integer>
            <key>Hour</key>
            <integer>23</integer>
            <key>Minute</key>
            <integer>59</integer>
        </dict>
        <dict>
            <key>Weekday</key>
            <integer>6</integer>
            <key>Hour</key>
            <integer>23</integer>
            <key>Minute</key>
            <integer>59</integer>
        </dict>
    </array>

    <key>RunAtLoad</key>
    <false/>

    <!-- PATH must cover: node (/usr/local/bin), ffmpeg (/opt/homebrew/bin),
         claude (~/.local/bin), say (/usr/bin) -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>__HOME__/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>__HOME__</string>
    </dict>
</dict>
</plist>
