# ─────────────────────────────────────────────────────────────────────────────
#  YOUR SECRETS. Copy this file to ".env" and fill in what you have.
#
#    cp .env.example .env
#    chmod 600 .env
#
#  RULES THAT WILL SAVE YOU A DAY OF DEBUGGING:
#    1. .env is in .gitignore. NEVER remove it. Never commit this file filled in.
#    2. Every line must end with a newline. A missing final newline makes the
#       next value FUSE with the next key and everything silently 401s.
#    3. No quotes, no spaces around "=".  KEY=value
#    4. After ANY edit to .env, restart the Telegram bot. It caches .env at
#       startup, so an un-restarted bot keeps running on the old broken value.
#
#  You do NOT need all of these. Start with the first two.
# ─────────────────────────────────────────────────────────────────────────────

# ── REQUIRED for the Telegram bot (Phase 4) ─────────────────────────────────
# From @BotFather in Telegram: /newbot, then copy the token it gives you.
TELEGRAM_BOT_TOKEN=
# From @userinfobot in Telegram: message it, copy your numeric id.
# This is the allowlist. Only this user id can talk to your brain.
TELEGRAM_ALLOWED_USER_ID=

# ── OPTIONAL: Notion (mirror pages, log captures to a Read/Watch database) ───
# notion.so/my-integrations -> New integration -> copy the Internal Secret.
# Then in Notion, share each page/database WITH that integration or it 404s.
NOTION_TOKEN=
# 32-char id from the URL of a database where captures get logged.
NOTION_READWATCH_DB=
# 32-char id of a Notion database you journal in (skip if you don't).
NOTION_JOURNAL_DB=
# 32-char id of a Notion database of research/scouting rows (skip if you don't).
NOTION_RESEARCH_DB=

# ── OPTIONAL: voice notes on the evening report (ElevenLabs) ────────────────
# Without these the report still sends as text, and falls back to the macOS
# "say" voice. Nothing breaks.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ── OPTIONAL: task sync (TickTick) ──────────────────────────────────────────
# Only if you want plan items pushed into a real to-do app.
# Run: node system/telegram/ticktick-auth.js  to get the access token.
TICKTICK_CLIENT_ID=
TICKTICK_CLIENT_SECRET=
TICKTICK_ACCESS_TOKEN=

# ── OPTIONAL: published-content corpus (what have I already said publicly) ──
KIT_API_KEY=
SUBSTACK_BASE=

# ── OPTIONAL: wearable / meeting capture ────────────────────────────────────
LIMITLESS_API_KEY=

# ── OPTIONAL: overrides ─────────────────────────────────────────────────────
# Absolute path to a local whisper binary, if it is not on your PATH.
WHISPER_BIN=
